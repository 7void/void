# MongoDB Connection URI (Atlas or Local)
# For local MongoDB: mongodb://127.0.0.1:27017/void_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/void_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/void_db

# Authentication Secret for signing JWT session tokens
JWT_SECRET=void_dev_secret_jwt_key_please_change_in_production_min32chars

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
